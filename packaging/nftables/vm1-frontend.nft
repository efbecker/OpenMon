#!/usr/sbin/nft -f
# /etc/nftables.d/openmon-frontend.nft - VM 1 (Frontend + coletores)
# Incluir a partir de /etc/nftables.conf:  include "/etc/nftables.d/*.nft"
# Ajuste os conjuntos abaixo antes de ativar (nft -c -f para validar).

table inet openmon_frontend
delete table inet openmon_frontend

table inet openmon_frontend {
    # Redes de administração com acesso SSH à VM 1
    set admin_v4 {
        type ipv4_addr; flags interval
        elements = { 10.10.0.0/24 }
    }
    # VM 2 (banco)
    set db_v4 {
        type ipv4_addr
        elements = { 10.10.0.20 }
    }

    chain input {
        type filter hook input priority filter; policy drop;
        ct state established,related accept
        ct state invalid drop
        iif "lo" accept
        meta l4proto { icmp, ipv6-icmp } accept
        tcp dport { 80, 443 } accept
        tcp dport 22 ip saddr @admin_v4 accept
        # Traps SNMP / syslog dos ativos (habilitar quando o receptor existir)
        # udp dport { 162, 514 } ip saddr 10.20.0.0/16 accept
        counter drop
    }

    chain output {
        type filter hook output priority filter; policy accept;
        # Para o banco só PostgreSQL (TLS obrigatório pelo pg_hba da VM 2) e SSH do deploy
        ip daddr @db_v4 tcp dport { 22, 5432 } accept
        ip daddr @db_v4 counter drop
    }
}
