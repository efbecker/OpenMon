# /etc/systemd/system/openmon-backup.timer
# O horário é definido pelo painel (Sistema > Backup): a aplicação grava
# /var/lib/openmon/backup-schedule.conf e openmon-backup-reschedule.path
# aplica o drop-in em /etc/systemd/system/openmon-backup.timer.d/
[Unit]
Description=OpenMon agendamento do backup
PartOf=openmon.target

[Timer]
OnCalendar=*-*-* 02:30:00
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
